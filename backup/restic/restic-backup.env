# Env vars that are used by run-in-btrfs-snapshot.sh.
TARGET_PARTITION_UUID=

# Env vars that are used by restic-backup.sh
COPY_CONNECTIONS=5
EXCLUDE_FILE_PATH=CONFIG_DIR/exclude

FILES_FROM_PATH=CONFIG_DIR/include_files

KEEP_YEARLY=3
KEEP_MONTHLY=24
KEEP_WEEKLY=4
KEEP_DAILY=7
KEEP_HOURLY=48
KEEP_LAST=10
KEEP_WITHIN=14d

LOCAL_REPOSITORY_RELATIVE_PATH=Backups/Restic
LOCAL_REPOSITORY_PASSWORD_FILE=CONFIG_DIR/credentials/repository-password

REMOTE_REPOSITORY=
REMOTE_REPOSITORY_PASSWORD_FILE=CONFIG_DIR/credentials/repository-password

# Env vars that are used by Restic.
AWS_PROFILE=restic
AWS_SHARED_CREDENTIALS_FILE=CONFIG_DIR/credentials/aws-credentials
RESTIC_CACHE_DIR=/root/.cache/restic
