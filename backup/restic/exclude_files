# Files to exclude from Restic backups

# Ignore most of /
# In Fedora Atomic 42+ the /home, /opt and /root entries as symlinks to
# directories in /var.
/
!/etc
!/home
!/opt
!/root
!/var/home
!/var/opt
!/var/roothome

# Caches
*cache
*Cache
.cache
cache
Cache
CachedData
CacheStorage

# Containers, volumes and user-scoped Flatpaks
.local/share/containers
.local/share/flatpak

# VM images
gnome-boxes/images
.var/app/org.virt_manager.virt-manager/data/images

# Software development generated directories
.cargo/git
.cargo/registry
build
cmake-build-*
node_modules
target

# Manually-installed applications
.local/share/clion-*
.local/share/tor-browser
.local/share/yubico-authenticator-*-linux

# Games installed using Heroic Games Launcher
# This probably needs to be adjusted for games that store saves in their
# install paths, and to exclude more generic files from Wine prefixes.
Games/Heroic/*
!Games/Heroic/Unreal Tournament 2004/Saves
!Games/Heroic/Prefixes/*/*/drive_c/users

# Steam
# Add cancellations for any games that store saves in their install paths (like
# Morrowind).
.steam
.local/share/Steam
!.local/share/Steam/config/*.vdf
!.local/share/Steam/steamapps/*.acf
!.local/share/Steam/steamapps/libraryfolders.vdf
!.local/share/Steam/steamapps/compatdata/*/pfx/drive_c/users
!.local/share/Steam/steamapps/common/Morrowind/Saves
!.local/share/Steam/userdata

# Misc files and folders
*.socket
.local/share/JetBrains
.var/app/com.usebottles.bottles/data/bottles
.wine/drive_c/windows
Downloads
